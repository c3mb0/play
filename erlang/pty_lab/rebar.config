{erl_opts, [debug_info, warnings_as_errors]}.
{deps, []}.
{eunit_opts, [verbose]}.
%% External runner/API and supervisor MFA callbacks are not direct call sites.
{xref_ignores, [{experiment_runner, run, 2}, {receipt_writer, start_link, 0},
                {session_sup, start_link, 0}, {session_worker, start_link, 1},
                {session_worker, status, 1}, {receipt_experiment, capture, 3},
                {receipt_experiment, recover, 2}, {receipt_recovery, analyze, 2}]}.
